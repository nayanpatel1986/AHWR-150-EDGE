# AHWR-150 EDGE deployment template
# Copy to settings.env on the target machine and replace every CHANGE_ME value.
# Never commit the completed settings.env file.

NODE_ENV=production
PORT=8080
DATA_SOURCE=influx
DATA_DIR=./data/app
FRONTEND_DIST_DIR=./app/frontend/dist
TELEGRAF_CONFIG_PATH=./app/telegraf/telegraf.conf

INFLUX_URL=http://127.0.0.1:8086
INFLUX_ORG=CHANGE_ME
INFLUX_BUCKET=CHANGE_ME
INFLUX_TOKEN=CHANGE_ME_GENERATE_UNIQUE_TOKEN

AUTH_MODE=local
ADMIN_USERNAME=admin
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
CORS_ORIGIN=http://localhost:8080

DEVICE_ID=CHANGE_ME_UNIQUE_RIG_ID
DEVICE_TOKEN=CHANGE_ME_UNIQUE_DEVICE_TOKEN
CENTRAL_URL=https://CHANGE_ME_CENTRAL_HOST
SYNC_ENABLED=false
SYNC_BATCH_SECONDS=5
SYNC_BUFFER_DAYS=7

ETP_ENABLED=false
ETP_URL=wss://CHANGE_ME_CENTRAL_HOST
ETP_STREAM_SECONDS=1

# Optional LDAP integration
LDAP_URL=
LDAP_STARTTLS=true
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_DOMAIN=
LDAP_DEFAULT_ROLE=viewer
LDAP_ROLE_ADMIN=
LDAP_ROLE_OPERATOR=
LDAP_ROLE_VIEWER=

# Optional Kepware OPC-UA integration
KEPWARE_OPCUA_URL=
KEPWARE_OPCUA_USERNAME=
KEPWARE_OPCUA_PASSWORD=
KEPWARE_SECURITY_POLICY=Basic256Sha256
KEPWARE_SECURITY_MODE=SignAndEncrypt
KEPWARE_CERT_PATH=
KEPWARE_PRIVATE_KEY_PATH=

BOP_CONFIG_PATH=./data/app/bop_config.json
BOP_RECONNECT_INITIAL_SECONDS=2
BOP_RECONNECT_MAX_SECONDS=30
MAX_WELL_DEPTH_M=10000

