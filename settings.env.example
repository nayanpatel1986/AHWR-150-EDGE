# AHWR-150 EDGE deployment template — TimescaleDB edition
# Copy to settings.env on the target machine and replace every CHANGE_ME value
# (Start-AHWR-EDGE.ps1 creates it for you on first run). Never commit settings.env.

NODE_ENV=production
PORT=8080
# Listen address (default all interfaces). 127.0.0.1 = this PC only.
HOST=
# HTTPS for the HMI and API (with HSTS): PEM certificate and key files.
TLS_CERT_FILE=
TLS_KEY_FILE=
DATA_SOURCE=plc
DATA_DIR=./data/app
FRONTEND_DIST_DIR=./app/frontend/dist
TELEGRAF_CONFIG_PATH=./app/telegraf/telegraf.d/plc.conf

# Rig identity: the historian rig_id, the Telegraf rig_id tag and the CMF device
# id. Exactly as registered at the CMF; never change it after the first upload.
DEVICE_ID=CHANGE_ME_UNIQUE_RIG_ID

# Historian: PostgreSQL + TimescaleDB, database ahwr_edge (app/sql/*.sql)
#   PG_MODE=bundled  runtime\pgsql started by the scripts, data in data\pgdata
#   PG_MODE=service  an installed PostgreSQL service (Edge Installation Guide)
PG_MODE=bundled
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ahwr_edge
PGUSER=ahwr_app
PGPASSWORD=CHANGE_ME_APP_DB_PASSWORD
TELEGRAF_DB_PASSWORD=CHANGE_ME_TELEGRAF_DB_PASSWORD
# postgres superuser: used only by the scripts to create/upgrade the schema.
PG_SUPERUSER_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# PG_MODE=service: the installed PostgreSQL Windows service (Install-AHWR-EDGE-Services.ps1)
# PG_SERVICE_NAME=postgresql-x64-18
# Operating records (users, work orders, logbook, ...) live in the database
# (app.documents). PERSIST_BACKEND=file keeps JSON files instead: tests only.
# PERSIST_BACKEND=db

# Telegraf 1.32+: keep retrying a PLC that is unreachable at start. Detected
# from runtime\telegraf by the scripts; set true/false to override.
# TELEGRAF_STARTUP_RETRY=

AUTH_MODE=local
ADMIN_USERNAME=admin
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
CORS_ORIGIN=http://localhost:8080

DEVICE_TOKEN=CHANGE_ME_UNIQUE_DEVICE_TOKEN
CENTRAL_URL=https://CHANGE_ME_CENTRAL_HOST
SYNC_ENABLED=false
SYNC_BATCH_SECONDS=5
SYNC_BUFFER_DAYS=7

# ETP v1.2 ChannelStreaming publisher (docs/witsml-interchange.md)
ETP_ENABLED=false
ETP_URL=wss://CHANGE_ME_CENTRAL_HOST
ETP_STREAM_SECONDS=1
# CENTRAL_URL / ETP_URL must be https:// / wss:// unless they point at this PC.
# true allows plain http/ws to other hosts (isolated test networks only).
ALLOW_INSECURE_TRANSPORT=false

# Limits: rows per WITSML log export; history query results kept in memory.
WITSML_MAX_ROWS=50000
HISTORY_CACHE_MAX=200

# Optional LDAP integration
LDAP_URL=
LDAP_STARTTLS=true
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_DOMAIN=
LDAP_DEFAULT_ROLE=viewer
LDAP_ROLE_ADMIN=
LDAP_ROLE_OPERATOR=
LDAP_ROLE_VIEWER=

# Optional Kepware OPC-UA integration (BOP collector -> Telegraf listener)
KEPWARE_OPCUA_URL=
KEPWARE_OPCUA_USERNAME=
KEPWARE_OPCUA_PASSWORD=
KEPWARE_SECURITY_POLICY=Basic256Sha256
KEPWARE_SECURITY_MODE=SignAndEncrypt
KEPWARE_CERT_PATH=
KEPWARE_PRIVATE_KEY_PATH=
TELEGRAF_LISTENER_URL=http://127.0.0.1:8186

BOP_CONFIG_PATH=./data/app/bop_config.json
BOP_RECONNECT_INITIAL_SECONDS=2
BOP_RECONNECT_MAX_SECONDS=30
MAX_WELL_DEPTH_M=10000

# Only for Migrate-AHWR-EDGE-InfluxDB.ps1 (one-time copy of InfluxDB-edition history)
# INFLUX_TOKEN=
# INFLUX_ORG=romii_org
# INFLUX_BUCKET=romii_bucket
